# Copy this file to .env and put your real Murf API keys there.
# Every line that starts with MURF_KEY_ becomes one choice in the app.
# The part after MURF_KEY_ is the name you will see (e.g. MAIN, PROJECT2).
# Never share .env and never put it in Git.

MURF_KEY_MAIN=paste_your_main_key_here
MURF_KEY_PROJECT2=paste_your_second_key_here
